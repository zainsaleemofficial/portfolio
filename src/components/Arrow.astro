---
interface Props {
  diagonal?: boolean
  direction?: 'right' | 'down' | 'left'
}
const { diagonal = false, direction = 'right' } = Astro.props
const rotation = { right: 0, down: 90, left: 180 }[direction]
---

<svg
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  style={`transform:rotate(${rotation}deg)`}
>
  <path d={diagonal ? 'M5 19 19 5M5 5h14v14' : 'M4 12h16m-6-6 6 6-6 6'} />
</svg>
