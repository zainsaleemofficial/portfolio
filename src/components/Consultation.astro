---
import { site } from '../data/site'
import Arrow from './Arrow.astro'
---

<section class="consultation section" id="book">
  <div class="container consultation-inner" data-reveal>
    <div>
      <p class="eyebrow">A good place to begin</p>
      <h2>
        Something in mind?
        <br />
        <span class="serif">Let’s talk it through.</span>
      </h2>
      <p>
        Building a product, improving a workflow, or working on search
        visibility? Let’s find a useful starting point.
      </p>
    </div>
    <div class="consultation-actions">
      <a
        class="button"
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call <Arrow diagonal />
      </a>
      <a class="text-link" href="/contact/">
        Prefer to write? <Arrow />
      </a>
      <p class="small">A conversation before a commitment.</p>
    </div>
  </div>
</section>
