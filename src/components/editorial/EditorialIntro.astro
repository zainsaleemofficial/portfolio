---
interface Props {
  eyebrow: string
  tone?: 'paper' | 'forest' | 'mint'
  class?: string
}
const { eyebrow, tone = 'paper', class: className } = Astro.props
---

<section class:list={['ed-intro', `ed-tone-${tone}`, className]}>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <div class="ed-intro-grid">
      <h1>
        <slot name="heading" />
      </h1>
      <div class="ed-intro-copy">
        <slot />
      </div>
    </div>
    {Astro.slots.has('after') && (
      <div class="ed-intro-after">
        <slot name="after" />
      </div>
    )}
  </div>
</section>
