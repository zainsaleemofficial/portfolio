---
import { site } from '../data/site'
import Arrow from './Arrow.astro'
const links = [
  ['Work', '/work/'],
  ['Services', '/services/'],
  ['About', '/about/'],
  ['My Story', '/my-story/'],
  ['Experience', '/experience/'],
  ['Contact', '/contact/'],
]
const currentPath = Astro.url.pathname
const current = (href: string) =>
  currentPath === href
    ? 'page'
    : href === '/services/' && currentPath.startsWith(href)
      ? 'location'
      : undefined
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        z.
      </span>
      <span>
        Zain Saleem<span class="brand-sub">SaaS · AI · SEO</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map(([label, href]) => (
        <a href={href} aria-current={current(href)}>
          {label}
        </a>
      ))}
    </nav>
    <a
      class="header-cta"
      href={site.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Book a Call <Arrow diagonal />
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation"
      hidden
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Mobile navigation" hidden>
    {links.map(([label, href]) => (
      <a href={href} aria-current={current(href)}>
        {label}
      </a>
    ))}
    <a
      class="button"
      href={site.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Book a Call <Arrow diagonal />
    </a>
  </nav>
  <noscript>
    <nav class="no-js-nav" aria-label="Navigation without JavaScript">
      {links.map(([label, href]) => (
        <a href={href} aria-current={current(href)}>
          {label}
        </a>
      ))}
      <a
        class="button"
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a Call <Arrow diagonal />
      </a>
    </nav>
  </noscript>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!
  const menu = document.querySelector<HTMLElement>('#mobile-nav')!
  toggle.hidden = false
  function close() {
    menu.hidden = true
    toggle.setAttribute('aria-expanded', 'false')
    toggle.setAttribute('aria-label', 'Open navigation')
  }
  toggle.addEventListener('click', () => {
    const open = menu.hidden
    menu.hidden = !open
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute(
      'aria-label',
      open ? 'Close navigation' : 'Open navigation',
    )
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      close()
      toggle.focus()
    }
  })
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close))
  matchMedia('(min-width: 1024px)').addEventListener('change', close)
</script>
