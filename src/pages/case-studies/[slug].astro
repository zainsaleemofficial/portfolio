---
import Layout from '../../layouts/Layout.astro'
import ContentSections from '../../components/ContentSections.astro'
import Consultation from '../../components/Consultation.astro'
import { caseStudies } from '../../data/content'
export function getStaticPaths() {
  return caseStudies
    .filter((c) => c.approved)
    .map((study) => ({ params: { slug: study.slug }, props: { study } }))
}
const { study } = Astro.props
---

<Layout title={`${study.title} — Zain Saleem`} description={study.summary}>
  <section class="section page-intro">
    <div class="container">
      <a class="text-link" href="/work/">
        ← Work
      </a>
      <p class="eyebrow">{study.kind} case study</p>
      <h1>{study.title}</h1>
      <p class="large-copy">{study.summary}</p>
    </div>
  </section>
  <article class="section container reading-width prose">
    <h2>The problem</h2>
    <p>{study.problem}</p>
    {study.kind === 'software' ? (
      <>
        <h2>The solution</h2>
        <p>{study.solution}</p>
        <h2>My role</h2>
        <p>{study.role}</p>
        <h2>Technical decisions</h2>
        <ul>
          {study.decisions.map((d) => (
            <li>{d}</li>
          ))}
        </ul>
        <h2>Stack</h2>
        <p>{study.stack.join(' · ')}</p>
      </>
    ) : (
      <>
        <h2>Baseline & period</h2>
        <p>{study.baseline}</p>
        <p>{study.period}</p>
        <h2>Work performed</h2>
        <ul>
          {study.work.map((w) => (
            <li>{w}</li>
          ))}
        </ul>
        <h2>Evidence</h2>
        {study.evidence.map((e) => (
          <p>{e}</p>
        ))}
      </>
    )}
    <h2>Verified outcome</h2>
    <p>{study.outcome}</p>
    <ContentSections sections={study.sections} />
  </article>
  <Consultation />
</Layout>
