---
import Layout from '../../layouts/Layout.astro'
import storyMarkup from '../../data/story-editorial.html?raw'
import '../../styles/story-editorial.css'
---

<Layout>
  <div class="story-v2" set:html={storyMarkup} />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.story-v2')
  if (root) {
    const sections = [...root.querySelectorAll<HTMLElement>('[data-chapter]')]
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-toc]')]
    const progress = root.querySelector<HTMLElement>('#progress')
    const percent = root.querySelector<HTMLElement>('#pct')
    const surface = root.querySelector<HTMLElement>('.story-surface')
    const update = () => {
      if (!surface || !progress || !percent || !sections.length) return
      let active = sections[0]
      const threshold = window.innerHeight * 0.38
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= threshold) active = section
      }
      for (const link of links) {
        const selected = link.dataset.toc === active.id
        link.classList.toggle('active', selected)
        if (selected) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
      const bounds = surface.getBoundingClientRect()
      const total = Math.max(1, bounds.height - window.innerHeight * 0.5)
      const value = Math.max(
        0,
        Math.min(
          100,
          Math.round(((-bounds.top + window.innerHeight * 0.4) / total) * 100),
        ),
      )
      progress.style.width = `${value}%`
      percent.textContent = `${value}%`
    }
    window.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  }
</script>
