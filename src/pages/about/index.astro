---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import Consultation from '../../components/Consultation.astro'
import EditorialFrame from '../../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../../components/editorial/EditorialIntro.astro'
import EditorialSection from '../../components/editorial/EditorialSection.astro'
import NarrativePanel from '../../components/editorial/NarrativePanel.astro'
import { capabilities, interests } from '../../data/brand'
import { site } from '../../data/site'
---

<Layout>
  <EditorialFrame class="ed-about">
    <EditorialIntro eyebrow="About me / Zain Saleem">
      <Fragment slot="heading">
        Curious first.
        <br />
        <span class="serif">Building ever since.</span>
      </Fragment>
      <p>
        I'm Zain, an AI-assisted SaaS builder with a background in SEO. I like
        understanding what gets in people's way—and helping make the work
        easier.
      </p>
      <p>
        Today, I'm Head of SaaS at a UK-based software product company. My work
        brings together products, automation, search and the people who keep it
        all moving.
      </p>
      <a class="text-link" href="/my-story/">
        Read my full story <Arrow diagonal />
      </a>
    </EditorialIntro>
    <EditorialSection
      tone="mint"
      id="the-person"
      labelledBy="about-person-title"
    >
      <div class="ed-about-person">
        <figure class="ed-portrait">
          <img
            src={site.portrait.src}
            width={site.portrait.width}
            height={site.portrait.height}
            alt={site.portrait.alt}
            loading="lazy"
          />
          <figcaption>Zain Saleem / The person behind the work</figcaption>
        </figure>
        <div class="ed-stack">
          <div>
            <p class="eyebrow">A habit that stayed with me</p>
            <h2 id="about-person-title">
              I want to know
              <br />
              <span class="serif">why it works.</span>
            </h2>
          </div>
          <div class="ed-prose">
            <p>
              In school, that meant learning HTML and CSS, experimenting with
              scripts, and breaking things until I understood them. At fifteen,
              it meant volunteering to help when a website went down at work.
            </p>
            <p>
              SEO taught me about delivery, trust and teams. A weekend software
              challenge brought me into product work. The tools changed; the
              habit of following a problem stayed.
            </p>
            <p>
              I don't need a project to sound impressive. I want to understand
              what someone needs, build what helps, and see whether it works for
              them.
            </p>
          </div>
          <a class="text-link" href="/experience/">
            The experience behind that approach <Arrow diagonal />
          </a>
        </div>
      </div>
    </EditorialSection>
    <EditorialSection tone="forest" labelledBy="about-work-title">
      <div class="ed-split">
        <div>
          <p class="eyebrow">The work today</p>
          <h2 id="about-work-title">
            Different tools.
            <br />
            <span class="serif">The same care.</span>
          </h2>
        </div>
        <p class="large-copy">
          A product needs to work for its users. A workflow needs to hold up on
          a busy day. A website needs to make sense to the people looking for
          it.
        </p>
      </div>
      <div class="ed-capabilities">
        {capabilities.map((item, i) => (
          <article>
            <p class="eyebrow">
              {String(i + 1).padStart(2, '0')} / {item.label}
            </p>
            <h3>{item.heading}</h3>
            <p>{item.description}</p>
            <a class="text-link" href={item.href}>
              Explore this area <Arrow diagonal />
            </a>
          </article>
        ))}
      </div>
    </EditorialSection>
    <EditorialSection labelledBy="about-life-title">
      <div class="ed-split">
        <div>
          <p class="eyebrow">Beyond work</p>
          <h2 id="about-life-title">
            Away from
            <br />
            <span class="serif">the screen.</span>
          </h2>
        </div>
        <div class="ed-stack">
          <div class="ed-prose">
            <p>
              I write poetry, read, cook and play cricket with friends. I like
              having parts of my day that aren't about shipping features or
              checking a campaign.
            </p>
            <p>
              I'd like to build a business of my own around software and SEO one
              day. For now, I care about doing the work in front of me well and
              meeting people with thoughtful problems to solve.
            </p>
          </div>
          <NarrativePanel label="In the quiet hours">
            <p>Curiosity has a life outside work, too.</p>
            <ul slot="caption" class="brand-interests">
              {interests.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </NarrativePanel>
        </div>
      </div>
    </EditorialSection>
    <Consultation />
  </EditorialFrame>
</Layout>
