---
import Layout from '../../layouts/Layout.astro'
import ContentSections from '../../components/ContentSections.astro'
import Consultation from '../../components/Consultation.astro'
import { projects } from '../../data/content'
export function getStaticPaths() {
  return projects
    .filter((p) => p.approved)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }))
}
const { project } = Astro.props
---

<Layout title={`${project.title} — Zain Saleem`} description={project.summary}>
  <section class="section page-intro">
    <div class="container">
      <a class="text-link" href="/work/">
        ← Work
      </a>
      <h1>{project.title}</h1>
      <p class="large-copy">{project.summary}</p>
    </div>
  </section>
  <article class="section container reading-width prose">
    <h2>My role</h2>
    <p>{project.role}</p>
    <p>{project.ownership}</p>
    <h2>Technology</h2>
    <p>{project.stack.join(' · ')}</p>
    {project.image && <img {...project.image} loading="lazy" />}
    <ContentSections sections={project.sections} />
  </article>
  <Consultation />
</Layout>
