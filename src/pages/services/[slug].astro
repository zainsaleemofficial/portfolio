---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import Consultation from '../../components/Consultation.astro'
import { services } from '../../data/site'
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))
}
const { service } = Astro.props
---

<Layout>
  <section class="section page-intro">
    <div class="container">
      <a class="text-link" href="/services/">
        <Arrow direction="left" /> All services
      </a>
      <p class="eyebrow">{service.group} / Services</p>
      <h1>
        {service.title}
        <span class="accent">.</span>
      </h1>
      <p class="large-copy">{service.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="container service-detail-grid">
      <div>
        <p class="eyebrow">The starting point</p>
        <h2>
          A considered
          <br />
          <span class="serif">approach.</span>
        </h2>
      </div>
      <div class="prose">
        <p class="large-copy">{service.intro}</p>
        <h2>What the work can include</h2>
        <ul>
          {service.scope.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h2>How we start</h2>
        <p>{service.process}</p>
        <h2>Setting expectations</h2>
        <p>{service.note}</p>
      </div>
    </div>
  </section>
  <Consultation serviceTitle={service.title} />
</Layout>
