---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import Consultation from '../../components/Consultation.astro'
import EditorialFrame from '../../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../../components/editorial/EditorialIntro.astro'
import EditorialSection from '../../components/editorial/EditorialSection.astro'
import NarrativePanel from '../../components/editorial/NarrativePanel.astro'
import ReadingNav from '../../components/editorial/ReadingNav.astro'
import { services, site } from '../../data/site'
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))
}
const { service } = Astro.props
const email = `mailto:${site.email}?subject=${encodeURIComponent(`Inquiry — ${service.title}`)}`
---

<Layout>
  <EditorialFrame class="ed-service">
    <EditorialIntro
      eyebrow={`${service.group} / Services`}
      tone={service.group === 'Build' ? 'forest' : 'mint'}
    >
      <a slot="before" class="text-link" href="/services/">
        <Arrow direction="left" /> All services
      </a>
      <Fragment slot="heading">
        {service.title}
        <span aria-hidden="true">.</span>
      </Fragment>
      <p>{service.summary}</p>
      <a class="text-link" href={email}>
        Email about this service <Arrow diagonal />
      </a>
      <ReadingNav
        slot="after"
        items={[
          { id: 'starting-point', label: 'The problem' },
          { id: 'scope', label: 'The work' },
          { id: 'approach', label: 'How we start' },
        ]}
      />
    </EditorialIntro>
    <EditorialSection id="starting-point" labelledBy="service-problem-title">
      <div class="ed-split">
        <div>
          <p class="eyebrow">01 / The starting point</p>
          <h2 id="service-problem-title">
            A useful place
            <br />
            <span class="serif">to begin.</span>
          </h2>
        </div>
        <div class="ed-prose">
          <p class="ed-service-problem">{service.problem}</p>
          <p>{service.intro}</p>
        </div>
      </div>
    </EditorialSection>
    <EditorialSection id="scope" tone="mint" labelledBy="service-scope-title">
      <div class="ed-split">
        <div>
          <p class="eyebrow">02 / A scope we agree together</p>
          <h2 id="service-scope-title">What the work can include</h2>
        </div>
        <ol class="ed-scope-list">
          {service.scope.map((item, index) => (
            <li>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </EditorialSection>
    <EditorialSection id="approach" labelledBy="service-start-title">
      <div class="ed-split">
        <div class="ed-stack">
          <div>
            <p class="eyebrow">03 / The first conversation</p>
            <h2 id="service-start-title">How we start</h2>
          </div>
          <div class="ed-prose">
            <p>{service.process}</p>
          </div>
          <a
            class="text-link"
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Schedule a conversation <Arrow diagonal />
          </a>
        </div>
        <NarrativePanel label="Setting expectations">
          <p>
            Clear scope.
            <br />
            Honest expectations.
          </p>
          <p slot="caption">{service.note}</p>
        </NarrativePanel>
      </div>
    </EditorialSection>
    <Consultation serviceTitle={service.title} />
  </EditorialFrame>
</Layout>
