---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import Consultation from '../../components/Consultation.astro'
import { experience, brandHighlights } from '../../data/brand'
import EditorialFrame from '../../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../../components/editorial/EditorialIntro.astro'
import EditorialSection from '../../components/editorial/EditorialSection.astro'
import ReadingNav from '../../components/editorial/ReadingNav.astro'
---

<Layout>
  <EditorialFrame class="ed-experience">
    <EditorialIntro
      eyebrow="Experience / The work behind the work"
      tone="forest"
    >
      <Fragment slot="heading">
        Roles changed.
        <br />
        <span class="serif">The curiosity didn't.</span>
      </Fragment>
      <p>
        My career has moved from keeping websites running to leading SEO
        delivery and building AI-assisted products. I've learned to care as much
        about the business problem as the tool used to solve it.
      </p>
      <p>
        Some responsibilities grew within a role; others came through a separate
        engagement. These are the moments and lessons I carry into the work
        today.
      </p>
      <a class="text-link" href="/my-story/">
        Read the fuller story <Arrow diagonal />
      </a>
      <ReadingNav
        slot="after"
        items={[
          { id: 'milestones', label: 'Responsibilities' },
          { id: 'perspective', label: 'Scope in context' },
          { id: 'product-work', label: 'Product experience' },
        ]}
      />
    </EditorialIntro>
    <EditorialSection id="milestones" labelledBy="career-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Milestones and responsibilities</p>
          <h2 id="career-title">
            What I've learned
            <br />
            <span class="serif">along the way.</span>
          </h2>
        </div>
      </div>
      <div class="career-timeline">
        {experience.map((item, i) => (
          <article class="career-entry">
            <div class="career-marker">
              <span>{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="career-title">
              <p class="eyebrow">{item.when}</p>
              <h3>{item.organization}</h3>
              <p>{item.label}</p>
            </div>
            <div class="career-detail">
              <h4>{item.role}</h4>
              <p>{item.summary}</p>
              <ul>
                {item.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </EditorialSection>
    <EditorialSection
      id="perspective"
      tone="mint"
      labelledBy="perspective-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">A little perspective</p>
          <h2 id="perspective-title">
            The numbers
            <br />
            <span class="serif">need context.</span>
          </h2>
        </div>
        <p class="section-aside">
          These approximate figures describe projects, launches and people. The
          software is company-owned; the numbers describe my experience and
          responsibility.
        </p>
      </div>
      <div class="brand-metric-grid">
        {brandHighlights.map((item) => (
          <article class="brand-metric">
            <strong>{item.figure}</strong>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </EditorialSection>
    <EditorialSection
      id="product-work"
      tone="forest"
      labelledBy="product-work-title"
    >
      <div class="ed-split">
        <div>
          <p class="eyebrow">Selected product experience</p>
          <h2 id="product-work-title">
            Built to solve
            <br />
            <span class="serif">a real need.</span>
          </h2>
        </div>
        <div class="brand-reading ed-prose">
          <p>
            In my current role, I've worked across products including LemCal,
            LemSubs, LemWatch, LemForms, LemRank, LemTask, LemAudit and
            LemReveal. The products belong to the company; I'm sharing these
            names to give context to my professional work, not presenting a
            portfolio of personally owned products.
          </p>
          <p>
            LemCal grew out of a scheduling challenge involving more than 100
            booking pages and team workflows. LemSubs came from the need to keep
            track of recurring subscriptions. My contribution has spanned
            hands-on AI-assisted building, troubleshooting, product decisions,
            operations and bringing tools to market.
          </p>
          <p>
            I'm not publishing company-owned screenshots, client data or
            unapproved technical case studies. Where it makes sense to share
            outcomes later, I'll do that with context and permission.
          </p>
          <a class="text-link" href="/work/">
            Explore my areas of work <Arrow diagonal />
          </a>
        </div>
      </div>
    </EditorialSection>
    <Consultation />
  </EditorialFrame>
</Layout>
