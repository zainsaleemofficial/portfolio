---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import Consultation from '../../components/Consultation.astro'
import { experience, brandHighlights } from '../../data/brand'
---

<Layout>
  <section class="section page-intro brand-intro">
    <div class="container brand-lede">
      <div>
        <p class="eyebrow">Experience / The work behind the work</p>
        <h1>
          Roles changed.
          <br />
          <span class="serif">The curiosity didn't.</span>
        </h1>
      </div>
      <div class="brand-intro-copy">
        <p class="large-copy">
          My career has moved from keeping websites running to leading SEO
          delivery and building AI-assisted products. I've learned to care as
          much about the business problem as the tool used to solve it.
        </p>
        <p>
          The milestones below are a summary, not a claim that every engagement
          happened in a neat sequence. Dates are included only where
          established.
        </p>
        <a class="text-link" href="/my-story/">
          Read the fuller story <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Milestones and responsibilities</p>
          <h2>
            What I've learned
            <br />
            <span class="serif">along the way.</span>
          </h2>
        </div>
      </div>
      <div class="career-timeline">
        {experience.map((item, i) => (
          <article class="career-entry">
            <div class="career-marker">
              <span>{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="career-title">
              <p class="eyebrow">{item.when}</p>
              <h3>{item.organization}</h3>
              <p>{item.label}</p>
            </div>
            <div class="career-detail">
              <h4>{item.role}</h4>
              <p>{item.summary}</p>
              <ul>
                {item.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section brand-soft-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A little perspective</p>
          <h2>
            The numbers
            <br />
            <span class="serif">need context.</span>
          </h2>
        </div>
        <p class="section-aside">
          These are approximate measures of work and responsibility—not
          fabricated revenue claims or a gallery of client-owned products.
        </p>
      </div>
      <div class="brand-metric-grid">
        {brandHighlights.map((item) => (
          <article class="brand-metric">
            <strong>{item.figure}</strong>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container brand-prose-grid">
      <div>
        <p class="eyebrow">Selected product experience</p>
        <h2>
          Built to solve
          <br />
          <span class="serif">a real need.</span>
        </h2>
      </div>
      <div class="brand-reading">
        <p>
          At LemStudio I've worked across products including LemCal, LemSubs,
          LemWatch, LemForms, LemRank, LemTask, LemAudit and LemReveal. The
          products belong to the company; I'm sharing these names to give
          context to my professional work, not presenting a portfolio of
          personally owned products.
        </p>
        <p>
          LemCal grew out of a scheduling challenge involving more than 100
          booking pages and team workflows. LemSubs came from the need to keep
          track of recurring subscriptions. My contribution has spanned hands-on
          AI-assisted building, troubleshooting, product decisions, operations
          and bringing tools to market.
        </p>
        <p>
          I'm not publishing company-owned screenshots, client data or
          unapproved technical case studies. Where it makes sense to share
          outcomes later, I'll do that with context and permission.
        </p>
        <a class="text-link" href="/work/">
          Explore my areas of work <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
  <Consultation />
</Layout>
