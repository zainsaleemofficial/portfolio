---
import Layout from '../layouts/Layout.astro'
import BriefForm from '../components/BriefForm'
import Arrow from '../components/Arrow.astro'
import { site } from '../data/site'
---

<Layout
  title="Start a conversation — Zain Saleem"
  description="Book a call with Zain Saleem through Calendly, email me@zainsaleem.co directly, or prepare an optional email brief in your browser. Nothing is submitted online."
  noindex
>
  <section class="section page-intro">
    <div class="container">
      <p class="eyebrow">A conversation before a commitment</p>
      <h1>
        What are you
        <br />
        <span class="serif">working on?</span>
      </h1>
      <p class="large-copy">
        Tell me about the problem, the people it affects, and what you’d like to
        change.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-methods">
        <div>
          <h2>Book a Call</h2>
          <p>
            Schedule a conversation about your project. Calendly opens in a new
            tab so you can choose an available time and confirm your booking.
          </p>
          <a
            class="button"
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Book a Call <Arrow diagonal />
          </a>
        </div>
        <div>
          <h2>Send an Email</h2>
          <p>
            Prefer to write? Open your email app and send a message directly to
            {site.email}.
          </p>
          <a class="text-link contact-email" href={`mailto:${site.email}`}>
            Send an Email <Arrow diagonal />
          </a>
          <p class="small">
            If an email app doesn’t open, copy {site.email} into your email
            service.
          </p>
        </div>
      </div>
      <div id="email-brief" class="contact-brief">
        <h2>Prepare an Email Brief</h2>
        <p>
          Optional: organize your project details into a draft, then review and
          send it from your email app. Nothing is submitted through this
          website.
        </p>
        <BriefForm email={site.email} client:visible />
        <noscript>
          <p>
            JavaScript is needed to prepare a brief. Email{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a> directly or use
            the booking link above.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</Layout>
