---
import Layout from '../layouts/Layout.astro'
import Arrow from '../components/Arrow.astro'
---

<Layout>
  <section class="section page-intro">
    <div class="container">
      <p class="eyebrow">404 / A missing piece</p>
      <h1>
        Nothing here.
        <br />
        <span class="serif">Plenty to explore.</span>
      </h1>
      <p>This page may have moved, or the address may be incorrect.</p>
      <a class="button" href="/">
        Back to the homepage <Arrow diagonal />
      </a>
    </div>
  </section>
</Layout>
