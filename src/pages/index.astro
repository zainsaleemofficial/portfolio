---
import Layout from '../layouts/Layout.astro'
import Arrow from '../components/Arrow.astro'
import WorkGallery from '../components/WorkGallery.astro'
import DualExpertise from '../components/DualExpertise'
import Consultation from '../components/Consultation.astro'
import PublishedContent from '../components/PublishedContent.astro'
import { site, services, insightTopics } from '../data/site'
import { projects, caseStudies, articles } from '../data/content'
---

<Layout>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span> Zain Saleem /
            Independent perspective
          </p>
          <h1>
            Software with
            <br />
            <span class="serif">growth in mind.</span>
          </h1>
          <p class="hero-position">
            SaaS & Software Developer <span>× SEO Strategist</span>
          </p>
          <p class="hero-description">
            I build useful software and bring a search strategist’s perspective
            to the details that help it grow.
          </p>
          <div class="hero-actions">
            <a
              class="button"
              href={site.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Book a call <Arrow diagonal />
            </a>
            <a class="text-link" href="#work">
              Explore my work <Arrow />
            </a>
          </div>
        </div>
        <div class="hero-portrait">
          <div class="portrait-orbit" aria-hidden="true"></div>
          {site.portrait ? (
            <img
              src={site.portrait.src}
              width={site.portrait.width}
              height={site.portrait.height}
              alt={site.portrait.alt}
              fetchpriority="high"
            />
          ) : (
            <div class="portrait-placeholder">
              <span class="portrait-monogram" aria-hidden="true">
                zs<span>.</span>
              </span>
              <p>
                Original portrait
                <br />
                <span>Coming into the picture.</span>
              </p>
            </div>
          )}
          <div class="portrait-caption">
            <span>01 / The person behind the work</span>
            <span>Zain Saleem</span>
          </div>
        </div>
      </div>
      <div class="hero-bottom">
        <p>
          Built <strong>50+ SaaS tools</strong>
          <span>while working with a UK-based agency</span>
        </p>
        <a href="#work">
          A closer look <Arrow direction="down" />
        </a>
        <p class="hero-note">
          Development first.
          <br />
          Search in the thinking.
        </p>
      </div>
    </div>
  </section>
  <section class="section" id="work">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">01 / Selected areas of work</p>
          <h2>
            Built for a reason.
            <br />
            <span class="serif">Made to be useful.</span>
          </h2>
        </div>
        <div class="section-aside">
          <p>
            From software products to the systems behind them. A closer look at
            the kind of problems I work on.
          </p>
          <a class="text-link" href="/work/">
            Explore the work <Arrow diagonal />
          </a>
        </div>
      </div>
      <WorkGallery />
      <p class="publication-note">
        Individual projects are being prepared for publication. These original
        illustrations represent areas of expertise, not client products.
      </p>
      <PublishedContent
        items={projects}
        base="/projects"
        label="Published projects"
      />
    </div>
  </section>
  <section class="section about-section" id="about">
    <div class="container about-grid" data-reveal>
      <p class="eyebrow">02 / A little context</p>
      <div>
        <h2>
          Two perspectives.
          <br />
          <span class="serif">One way of thinking.</span>
        </h2>
        <p class="large-copy">
          My path into software began with understanding how people find things
          online.
        </p>
        <div class="about-columns">
          <p>
            Working in SEO taught me to look beyond a page: how it is
            structured, how people reach it, and whether it answers a real need.
            That perspective still shapes the way I work.
          </p>
          <p>
            Today, my primary focus is SaaS and software development. I bring
            that engineering mindset together with experience in technical SEO,
            local search, and link building.
          </p>
        </div>
        <a class="text-link" href="#experience">
          More about my experience <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="section expertise-section" id="expertise">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">03 / The intersection</p>
          <h2>
            A builder’s mind.
            <br />
            <span class="serif">A strategist’s eye.</span>
          </h2>
        </div>
        <p class="section-aside">
          Good software and thoughtful search strategy solve different parts of
          the same problem.
        </p>
      </div>
      <DualExpertise client:visible />
    </div>
  </section>
  <section class="section" id="services">
    <div class="container services-grid">
      <div class="services-intro" data-reveal>
        <p class="eyebrow">04 / How I can help</p>
        <h2>
          Clear problems.
          <br />
          <span class="serif">Useful solutions.</span>
        </h2>
        <p>
          Focused development and search services, with a practical scope and
          room for a proper conversation.
        </p>
        <a class="text-link" href="/contact/">
          Discuss your project <Arrow diagonal />
        </a>
      </div>
      <div class="service-list">
        {services.map((service, i) => (
          <details class="service-item">
            <summary>
              <span class="service-number">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>
                <span class="eyebrow">{service.group}</span>
                <span class="service-title">{service.title}</span>
              </span>
              <span class="service-plus" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="service-body">
              <p>{service.summary}</p>
              <p>{service.intro}</p>
              <a class="text-link" href={`/services/${service.slug}/`}>
                Explore this service <Arrow diagonal />
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section experience-section" id="experience">
    <div class="container experience-grid" data-reveal>
      <div>
        <p class="eyebrow">05 / Experience, with context</p>
        <div class="experience-number">
          50<span>+</span>
        </div>
        <h2>
          SaaS tools built
          <br />
          <span class="serif">in an agency environment.</span>
        </h2>
        <p>While working with a UK-based agency.</p>
      </div>
      <div class="experience-notes">
        <article>
          <p class="eyebrow">Software development</p>
          <h3>Learning through building.</h3>
          <p>
            Hands-on experience creating SaaS tools and software solutions
            within an agency setting. Individual projects, roles, and ownership
            details will be shared when approved.
          </p>
        </article>
        <article>
          <p class="eyebrow">Search expertise</p>
          <h3>A broader view of the website.</h3>
          <p>
            Experience working with SEO clients across technical SEO, local SEO,
            and backlink building. That background informs my approach to
            structure, performance, and discoverability.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">06 / Behind the decisions</p>
          <h2>
            The story
            <br />
            <span class="serif">behind the solution.</span>
          </h2>
        </div>
        <p class="section-aside">
          Good case studies explain the problem, the choices, and the evidence.
          Detailed stories are being prepared.
        </p>
      </div>
      {caseStudies.some((x) => x.approved) ? (
        <PublishedContent
          items={caseStudies}
          base="/case-studies"
          label="Case studies"
        />
      ) : (
        <div class="case-grid">
          <article>
            <span class="case-number">01</span>
            <p class="eyebrow">Software / Forthcoming</p>
            <h3>
              From problem
              <br />
              to working product.
            </h3>
            <p>
              Product context, my role, technical decisions, and a verifiable
              outcome.
            </p>
            <span class="small">Awaiting approved project details</span>
          </article>
          <article>
            <span class="case-number">02</span>
            <p class="eyebrow">Search / Forthcoming</p>
            <h3>
              From investigation
              <br />
              to informed action.
            </h3>
            <p>
              The baseline, the work, the time period, and what the evidence
              shows.
            </p>
            <span class="small">Awaiting approved case study evidence</span>
          </article>
        </div>
      )}
    </div>
  </section>
  <section class="section insights-section" id="insights">
    <div class="container insights-grid">
      <div data-reveal>
        <p class="eyebrow">07 / The writing desk</p>
        <h2>
          Notes from
          <br />
          <span class="serif">the intersection.</span>
        </h2>
        <p>
          On building software, understanding search, and learning from the
          work.
        </p>
        <a class="text-link" href="/insights/">
          Visit the writing desk <Arrow diagonal />
        </a>
      </div>
      <div>
        {articles.some((x) => x.approved) ? (
          <PublishedContent
            items={articles}
            base="/insights"
            label="Latest articles"
          />
        ) : (
          <>
            <p class="eyebrow">
              Topics on my mind / First articles forthcoming
            </p>
            <ul class="topic-list">
              {insightTopics.map((topic) => (
                <li>
                  {topic}
                  <Arrow diagonal />
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
  </section>
  <Consultation />
</Layout>
