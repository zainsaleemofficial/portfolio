---
import Layout from '../../layouts/Layout.astro'
import Consultation from '../../components/Consultation.astro'
import Arrow from '../../components/Arrow.astro'
import { capabilities } from '../../data/brand'
import EditorialFrame from '../../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../../components/editorial/EditorialIntro.astro'
import EditorialSection from '../../components/editorial/EditorialSection.astro'
---

<Layout>
  <EditorialFrame class="ed-expertise">
    <EditorialIntro
      eyebrow="Expertise / Two disciplines, one perspective"
      tone="mint"
    >
      <Fragment slot="heading">
        Make the work
        <br />
        <span class="serif">actually easier.</span>
      </Fragment>
      <p>
        Software, automation and SEO are different tools. I use them to tackle
        the same question: what's getting in the way, and how can we make it
        better?
      </p>
      <p>
        Building a product and helping people find it are connected problems.
        Automation can give the people behind both a more dependable way to
        work.
      </p>
      <a class="text-link" href="/services/">
        Explore all services <Arrow />
      </a>
      <ol
        class="ed-discipline-map"
        slot="after"
        aria-label="How the disciplines connect"
      >
        <li>
          <span>01 / Software</span>
          <strong>Make it useful.</strong>
          <p>Shape the product around a real need.</p>
        </li>
        <li>
          <span>02 / Automation</span>
          <strong>Connect the work.</strong>
          <p>Make the handoffs dependable.</p>
        </li>
        <li>
          <span>03 / Search</span>
          <strong>Help it be found.</strong>
          <p>Make the offer clear and discoverable.</p>
        </li>
      </ol>
    </EditorialIntro>
    <EditorialSection labelledBy="expertise-practice-title">
      <p class="eyebrow">In practice</p>
      <h2 id="expertise-practice-title" class="ed-expertise-heading">
        The problem decides
        <br />
        <span class="serif">where we begin.</span>
      </h2>
      <div class="expertise-rows">
        {capabilities.map((item, i) => (
          <article class="expertise-row">
            <div>
              <span class="ed-row-number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="eyebrow">{item.label}</p>
            </div>
            <h3>{item.heading}</h3>
            <div>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                See how I can help <Arrow diagonal />
              </a>
            </div>
          </article>
        ))}
      </div>
    </EditorialSection>
    <Consultation />
  </EditorialFrame>
</Layout>
