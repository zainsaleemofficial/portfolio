---
import Layout from '../../layouts/Layout.astro'
import Arrow from '../../components/Arrow.astro'
import ContentSections from '../../components/ContentSections.astro'
import { articles } from '../../data/content'
import EditorialFrame from '../../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../../components/editorial/EditorialIntro.astro'
import ReadingNav from '../../components/editorial/ReadingNav.astro'
export function getStaticPaths() {
  return articles
    .filter((a) => a.approved)
    .map((article) => ({ params: { slug: article.slug }, props: { article } }))
}
const { article } = Astro.props
---

<Layout title={`${article.title} — Zain Saleem`} description={article.summary}>
  <EditorialFrame class="ed-article">
    <EditorialIntro eyebrow={article.category}>
      <a slot="before" class="text-link" href="/insights/">
        <Arrow direction="left" /> Insights
      </a>
      <p>
        <time datetime={article.published}>{article.published}</time>
      </p>
      <Fragment slot="heading">{article.title}</Fragment>
      <p>{article.summary}</p>
      <p>By Zain Saleem</p>
    </EditorialIntro>
    <div class="section container ed-article-layout">
      {article.sections.length > 2 && (
        <ReadingNav
          items={article.sections.map((section, index) => ({
            id: `article-section-${index + 1}`,
            label: section.heading,
          }))}
        />
      )}
      <article class="ed-prose prose">
        <ContentSections sections={article.sections} />
      </article>
    </div>
  </EditorialFrame>
</Layout>
