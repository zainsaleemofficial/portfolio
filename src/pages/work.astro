---
import Layout from '../layouts/Layout.astro'
import WorkGallery from '../components/WorkGallery.astro'
import PublishedContent from '../components/PublishedContent.astro'
import Consultation from '../components/Consultation.astro'
import Arrow from '../components/Arrow.astro'
import { projects, caseStudies } from '../data/content'
import { brandNumbers } from '../data/brand'
import EditorialFrame from '../components/editorial/EditorialFrame.astro'
import EditorialIntro from '../components/editorial/EditorialIntro.astro'
import EditorialSection from '../components/editorial/EditorialSection.astro'
---

<Layout>
  <EditorialFrame class="ed-work">
    <EditorialIntro eyebrow="Work / The problems behind the practice">
      <Fragment slot="heading">
        Useful work.
        <br />
        <span class="serif">Thoughtful decisions.</span>
      </Fragment>
      <p>
        I've worked hands-on across {brandNumbers.softwareProjects} AI-assisted
        software projects, from experiments and internal tools to products that
        launched. I also bring experience leading off-page and local SEO
        delivery.
      </p>
      <p>
        The visuals below are original illustrations of work areas—not
        screenshots of company products or client case studies. Company-owned
        work stays private unless publication is approved.
      </p>
      <a class="text-link" href="/services/">
        Explore services for your project <Arrow />
      </a>
    </EditorialIntro>
    <EditorialSection tone="mint" labelledBy="work-areas-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A closer look</p>
          <h2 id="work-areas-title">
            Three kinds of problems.
            <br />
            <span class="serif">One thoughtful approach.</span>
          </h2>
        </div>
        <p class="section-aside">
          Illustrations of the work I can help with. Published projects and case
          studies will appear here only when facts and permissions are in place.
        </p>
      </div>
      <WorkGallery />
      <PublishedContent
        items={projects}
        base="/projects"
        label="Approved projects"
      />
      <PublishedContent
        items={caseStudies}
        base="/case-studies"
        label="Case studies"
      />
    </EditorialSection>
    <Consultation />
  </EditorialFrame>
</Layout>
