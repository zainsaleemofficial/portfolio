---
import '@fontsource-variable/manrope'
import '@fontsource/instrument-serif/latin-400-italic.css'
import '../styles/globals.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site, publicationApproved } from '../data/site'
import { brandIdentity } from '../data/brand'
import { seoPages } from '../data/seo.mjs'
import { structuredData } from '../data/structured-data'
interface Props {
  title?: string
  description?: string
  noindex?: boolean
}
const pageSEO = seoPages[Astro.url.pathname]
const title = pageSEO?.title ?? Astro.props.title ?? site.name
const description =
  pageSEO?.description ??
  Astro.props.description ??
  `Zain Saleem is ${brandIdentity.currentRole} at ${brandIdentity.currentCompany}, working across SaaS development, AI automation and SEO strategy.`
const canonical = new URL(Astro.url.pathname, site.url)
const indexable =
  publicationApproved &&
  import.meta.env.PUBLIC_DEPLOYMENT_ENV === 'production' &&
  pageSEO?.index === true &&
  !Astro.props.noindex
const production =
  publicationApproved && import.meta.env.PUBLIC_DEPLOYMENT_ENV === 'production'
const robots = indexable
  ? 'index, follow'
  : production
    ? 'noindex, follow'
    : 'noindex, nofollow'
const schema = structuredData(Astro.url.pathname, title, description)
---

<!doctype html>
<html lang="en" data-theme="dual-contrast">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f6f9f7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social-preview.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Zain Saleem — SaaS Development, AI Automation & SEO Strategy"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social-preview.png`} />
    <meta
      name="twitter:image:alt"
      content="Zain Saleem — SaaS Development, AI Automation & SEO Strategy"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)')
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement
          if (!reduced.matches) el.classList.add('in-view')
          observer.unobserve(el)
        }
      }
    },
    { threshold: 0.12 },
  )
  document
    .querySelectorAll('[data-reveal]')
    .forEach((el) => observer.observe(el))
</script>
